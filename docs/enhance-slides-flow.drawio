        <mxCell id="d1" value="Render every slide you touched to a PNG and read the image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1225" y="210" width="240" height="90" as="geometry" />
