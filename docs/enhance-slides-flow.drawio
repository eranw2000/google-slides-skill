        <mxCell id="gate" value="Fits the slide and reads correctly?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1225" y="340" width="240" height="160" as="geometry" />
