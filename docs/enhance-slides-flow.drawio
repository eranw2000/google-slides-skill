        <mxCell id="c2" value="Text fixes, titles, design pass, new slides, body styling, icons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="310" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Cards, code boxes, real tables, linked contents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="420" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage4" value="4. Verify" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;strokeWidth=2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="150" width="290" height="390" as="geometry" />
